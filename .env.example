# ==============================================================================
# SIH26079: AI-Based Forecast Bust Detection for Medium-Range Weather Forecasts
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
# Local Quickstart default: SQLite (Async)
DATABASE_URL=sqlite+aiosqlite:///./data.db
# Production PostgreSQL + PostGIS example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forecast_bust_db

# Weather Data Provider Credentials
# Google Weather API (Optional - will fall back to Open-Meteo & Historical Reanalysis)
GOOGLE_WEATHER_API_KEY=

# ECMWF Climate Data Store (CDS) API (for direct ERA5 downloads)
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=

# Open-Meteo Integration (Free, high-resolution global NWP ensembles & ERA5 reanalysis)
OPEN_METEO_ENABLED=true

# Demo & Offline Operation
# Set to 'true' to operate completely offline using verified benchmark historical datasets
DEMO_MODE=false

# Default Operational Region (India synoptic bounds)
DEFAULT_REGION_NORTH=37.5
DEFAULT_REGION_SOUTH=6.5
DEFAULT_REGION_WEST=68.0
DEFAULT_REGION_EAST=97.5

# Machine Learning & Automated Pipeline Thresholds
DATASET_VERSION_DEFAULT=dataset_v001
MODEL_VERSION_DEFAULT=model_v001
MIN_SAMPLES_FOR_RETRAIN=500
ACCEPTANCE_MIN_PR_AUC=0.60
ACCEPTANCE_MAX_BRIER_SCORE=0.20
ACCEPTANCE_MAX_ECE=0.15
