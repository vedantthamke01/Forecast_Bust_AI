# ==============================================================================
# Render Production Environment Variables
# Service: forecast-bust-api
# ==============================================================================

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=sih26079_ncmrwf_prod_secret_key_2026

# Database
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Live NWP Weather & Bust Detection
OPEN_METEO_ENABLED=true
DEMO_MODE=false

# Production Champion & Rollback Configuration
PRODUCTION_MODEL=global_v001
MODEL_VERSION_DEFAULT=global_v001
ROLLBACK_MODEL=model_real_v002
DATASET_VERSION_DEFAULT=dataset_global_v001
CANARY_ENABLED=false

# Synoptic Bounds
DEFAULT_REGION_NORTH=37.5
DEFAULT_REGION_SOUTH=6.5
DEFAULT_REGION_WEST=68.0
DEFAULT_REGION_EAST=97.5

# Copernicus CDS Reanalysis (Configured securely via environment variables)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=${CDS_API_KEY}
